# Medusa Backend Environment Template
# Copy to .env and configure for your environment

# ===== Core Configuration =====
DATABASE_URL=postgres://user:password@localhost/medusa-db
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# ===== CORS (comma-separated URLs) =====
STORE_CORS=http://localhost:4321
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# ===== Redis (optional) =====
# REDIS_URL=redis://localhost:6379

# ===== Resend Email =====
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=info@yourdomain.com

# ===== Midtrans Payment =====
MIDTRANS_SERVER_KEY=Mid-server-xxx
MIDTRANS_CLIENT_KEY=Mid-client-xxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_WEBHOOK_URL=https://your-ngrok-url/webhooks/midtrans
MIDTRANS_ENABLED_PAYMENTS=bca_va,bni_va,bri_va,mandiri_bill,permata_va,gopay,shopeepay

# ===== RajaOngkir/Komerce Shipping =====
RAJAONGKIR_API_KEY=your_api_key
RAJAONGKIR_API_DELIVERY_KEY=your_delivery_key
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_DELIVERY_BASE_URL=https://api-sandbox.collaborator.komerce.id/
RAJAONGKIR_ORIGIN_CITY_ID=153
RAJAONGKIR_ORIGIN_NAME=Store Name
RAJAONGKIR_ORIGIN_PHONE=08123456789
RAJAONGKIR_ORIGIN_ADDRESS=Jl. Example No. 123
RAJAONGKIR_ORIGIN_POSTAL_CODE=12345

# ===== Cloudflare R2 File Storage (Optional) =====
# Leave commented to use local file storage
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your-bucket-name
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
