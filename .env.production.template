# ================================================
# Backend Production Environment Template
# ================================================
# Copy this file to .env and fill in your production values
# Generate secure secrets: openssl rand -base64 32

# ===== Core Medusa Configuration =====
DATABASE_URL=postgres://username:password@your-db-host:5432/your-db-name
JWT_SECRET=your-secure-jwt-secret-here
COOKIE_SECRET=your-secure-cookie-secret-here

# ===== CORS Configuration =====
# Replace with your production domain(s)
STORE_CORS=https://yourdomain.com
ADMIN_CORS=https://admin.yourdomain.com,https://yourdomain.com/admin
AUTH_CORS=https://yourdomain.com,https://admin.yourdomain.com

# ===== Redis (Optional for production caching) =====
# REDIS_URL=redis://your-redis-host:6379

# ===== Resend Email Configuration =====
RESEND_API_KEY=re_your_production_api_key
RESEND_FROM_EMAIL=info@yourdomain.com

# ===== Midtrans Production Configuration =====
MIDTRANS_SERVER_KEY=Mid-server-XXXXXXXXXX
MIDTRANS_CLIENT_KEY=Mid-client-XXXXXXXXXX
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id
MIDTRANS_WEBHOOK_URL=https://api.yourdomain.com/webhooks/midtrans

# Optional: Restrict payment methods (comma-separated)
# Available: credit_card, bca_va, bni_va, bri_va, mandiri_bill, permata_va, gopay, shopeepay, etc.
MIDTRANS_ENABLED_PAYMENTS=bca_va,bni_va,bri_va,mandiri_bill,permata_va,gopay,shopeepay

# ===== RajaOngkir Production Configuration =====
# Komerce API for shipping cost calculation
RAJAONGKIR_API_KEY=your_production_api_key
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1

# Komerce Collaborator API for delivery booking (Production URL)
RAJAONGKIR_API_DELIVERY_KEY=your_production_delivery_key
RAJAONGKIR_DELIVERY_BASE_URL=https://api.collaborator.komerce.id/

# Origin/Sender Details
RAJAONGKIR_ORIGIN_CITY_ID=153
RAJAONGKIR_ORIGIN_NAME=Store Name
RAJAONGKIR_ORIGIN_PHONE=08123456789
RAJAONGKIR_ORIGIN_ADDRESS=Jl. Example No. 123
RAJAONGKIR_ORIGIN_POSTAL_CODE=12345

# ===== Cloudflare R2 File Storage =====
# Get credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-bucket-name

# S3-compatible endpoint: https://{account-id}.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Public URL for accessing files (use Custom Domain for production)
# Option 1: Custom Domain (recommended) - https://cdn.yourdomain.com
# Option 2: R2.dev URL (dev only) - https://pub-xxxxx.r2.dev
R2_PUBLIC_URL=https://cdn.yourdomain.com
